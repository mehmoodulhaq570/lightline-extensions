{
  "main": {
    "prefix": "main",
    "body": ["int main() {", "\t$0", "\treturn 0;", "}"],
    "description": "int main() { … }"
  },
  "main with arguments": {
    "prefix": "maina",
    "body": ["int main(int argc, char *argv[]) {", "\t$0", "\treturn 0;", "}"],
    "description": "int main(argc, argv) { … }"
  },
  "include": {
    "prefix": "inc",
    "body": ["#include <${1:iostream}>$0"],
    "description": "#include <header>"
  },
  "pragma once": {
    "prefix": "once",
    "body": ["#pragma once", "", "$0"],
    "description": "#pragma once"
  },
  "namespace": {
    "prefix": "ns",
    "body": ["namespace ${1:name} {", "", "$0", "", "}"],
    "description": "namespace name { … }"
  },
  "class": {
    "prefix": "class",
    "body": ["class ${1:Name} {", "public:", "\t$0", "", "private:", "};"],
    "description": "class Name { public: … private: … };"
  },
  "struct": {
    "prefix": "struct",
    "body": ["struct ${1:Name} {", "\t${2:int field;}$0", "};"],
    "description": "struct Name { … };"
  },
  "range for": {
    "prefix": "forr",
    "body": ["for (${1:const auto&} ${2:item} : ${3:items}) {", "\t$0", "}"],
    "description": "for (const auto& item : items)"
  },
  "for with an index": {
    "prefix": "fori",
    "body": ["for (std::size_t i = 0; i < ${1:items}.size(); ++i) {", "\t$0", "}"],
    "description": "for (std::size_t i = 0; i < items.size(); ++i)"
  },
  "if": {
    "prefix": "if",
    "body": ["if (${1:condition}) {", "\t$0", "}"],
    "description": "if (…) { … }"
  },
  "if else": {
    "prefix": "ife",
    "body": ["if (${1:condition}) {", "\t$2", "} else {", "\t$0", "}"],
    "description": "if (…) { … } else { … }"
  },
  "cout": {
    "prefix": "cout",
    "body": ["std::cout << ${1:value} << '\\n';$0"],
    "description": "std::cout << … << '\\n';"
  },
  "cin": {
    "prefix": "cin",
    "body": ["std::cin >> ${1:value};$0"],
    "description": "std::cin >> …;"
  },
  "vector": {
    "prefix": "vec",
    "body": ["std::vector<${1:int}> ${2:items};$0"],
    "description": "std::vector<T> items;"
  },
  "map": {
    "prefix": "map",
    "body": ["std::map<${1:std::string}, ${2:int}> ${3:counts};$0"],
    "description": "std::map<K, V> name;"
  },
  "unique pointer": {
    "prefix": "uptr",
    "body": ["auto ${1:item} = std::make_unique<${2:Type}>($3);$0"],
    "description": "auto item = std::make_unique<T>(…);"
  },
  "lambda": {
    "prefix": "lambda",
    "body": ["[${1:&}](${2:auto value}) {", "\t$0", "}"],
    "description": "[&](auto value) { … }"
  },
  "template": {
    "prefix": "tmpl",
    "body": ["template <typename ${1:T}>", "$0"],
    "description": "template <typename T>"
  },
  "try catch": {
    "prefix": "try",
    "body": [
      "try {",
      "\t$1",
      "} catch (const ${2:std::exception}& error) {",
      "\tstd::cerr << error.what() << '\\n';$0",
      "}"
    ],
    "description": "try { … } catch (const std::exception& error)"
  },
  "assert check": {
    "prefix": "test",
    "body": ["#include <cassert>", "", "int main() {", "\tassert(${1:condition});$0", "\treturn 0;", "}"],
    "description": "A minimal test: main with an assert"
  }
}
